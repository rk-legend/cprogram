#include <stdbool.h>
#include <math.h>

// Helper function to check if a number is prime
bool isPrime(int n) {
    if (n <= 1) return false;
    if (n == 2) return true;
    if (n % 2 == 0) return false; // Eliminate even numbers early
    
    int limit = (int)sqrt(n);
    for (int i = 3; i <= limit; i += 2) {
        if (n % i == 0) {
            return false;
        }
    }
    return true;
}

int diagonalPrime(int** nums, int numsSize, int* numsColSize) {
    int maxPrime = 0;
    int n = numsSize;

    for (int i = 0; i < n; i++) {
        // 1. Check primary diagonal element: nums[i][i]
        int val1 = nums[i][i];
        if (val1 > maxPrime && isPrime(val1)) {
            maxPrime = val1;
        }

        // 2. Check secondary diagonal element: nums[i][n - i - 1]
        int val2 = nums[i][n - i - 1];
        if (val2 > maxPrime && isPrime(val2)) {
            maxPrime = val2;
        }
    }

    return maxPrime;
}
