 #include<stdio.h>
 int main()
 {
  int a,b,c;
  char ch;
  printf("enter the choice:");
  scanf("%s",&ch);
  printf("enter the first number:");
  scanf("%d",&a);
  printf("enter the second number:");
  scanf("%d",&b);
}
switch(ch)
 {
    case '+':
      c=a+b;
      printf("sum=%d",c);
      break;
    case '-':
      c=a-b;
      printf("sub=%d",c);
      break;
    case '/':
      c=a/b;
      printf("division=%d",c);
      break;
    case '*':
      c=a*b;
      printf("multiplication=%d",c);
      break;
    default:
       printf("no operation:");
       
 }
 return 0;
 }
